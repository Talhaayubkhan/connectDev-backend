    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "nodemailer": "^9.0.3",
    "validator": "^13.15.26"
  },
  "devDependencies": {
